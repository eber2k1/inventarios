# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# --- Base de datos (Neon PostgreSQL) ---
# Conexión con pooler (runtime) y directa (migraciones)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH=""

# --- Comprobantes electrónicos SUNAT (Nubefact) ---
NUBEFACT_RUTA=""
NUBEFACT_TOKEN=""

# --- Consulta de DNI/RUC (Decolecta) ---
DECOLECTA_TOKEN=""

# --- Imágenes de productos (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Inicio de sesión (NextAuth + GitHub OAuth App) ---
# Callback de la OAuth App: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Usuarios de GitHub que pueden entrar, separados por comas
GITHUB_USUARIOS_PERMITIDOS=""
NEXTAUTH_URL="http://localhost:3000"
# Genera valores aleatorios largos, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=""
JWT_SECRET=""

# --- Correos (Resend) ---
RESEND_API_KEY=""
RESEND_FROM="Tiendita Enter <onboarding@resend.dev>"
